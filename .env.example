# Velcora POS & Enterprise Retail OS Environment Configuration Template
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL

# Firebase Web App Configuration (Required)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Supabase Storage & Relational Database (Optional / Secondary Sync)
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# DeepSeek AI API Key (Required for AI chat, reasoning, financial analysis)
# Server-side only — NEVER expose to browser or commit to Git.
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Gemini API Key (Required for image/video generation and Second Brain)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Firebase Admin Service Account (REQUIRED on serverless/Vercel for Credits + Staff Auth + Firestore writes)
# Paste the FULL service-account JSON on ONE line. Server-side only — NEVER expose or commit.
# Create at: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"admin-3666e","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@admin-3666e.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# SuperAdmin Security Email Authority
VITE_SUPERADMIN_PRIMARY_EMAIL=hurairahussain667@gmail.com

# Microservice & External Integration Endpoints
VITE_API_BASE_URL=http://localhost:3000
VITE_REFERRAL_API_BASE_URL=http://localhost:3001
VITE_SUPERADMIN_PORTAL_URL=http://localhost:5173/admin
