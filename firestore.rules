rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hurairahussain667@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        !('ownerUid' in get(/databases/$(database)/documents/businesses/$(businessId)).data) ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == null ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == '' ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid
      );
    }

    function isBusinessOwnerOrMember(businessData) {
      return isSignedIn() && (
        isSuperAdmin() ||
        !('ownerUid' in businessData) ||
        businessData.ownerUid == null ||
        businessData.ownerUid == '' ||
        request.auth.uid == businessData.ownerUid ||
        (businessData.memberUids != null && request.auth.uid in businessData.memberUids)
      );
    }

    function isAuthorizedForBusiness(businessId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        !('ownerUid' in get(/databases/$(database)/documents/businesses/$(businessId)).data) ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == null ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == '' ||
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid ||
        (get(/databases/$(database)/documents/businesses/$(businessId)).data.memberUids != null &&
         request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.memberUids)
      );
    }

    // Default catch-all allows super admin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // System configurations & Super Admin logs
    match /system/{document=**} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /referral_partners/{partnerId} {
      allow read, write: if true;
    }

    // Referral & Promoter Network Rules
    match /referral_promoters/{promoterId} {
      allow read, write: if true;
    }

    match /referral_codes/{codeId} {
      allow read, write: if true;
    }

    match /referral_leads/{leadId} {
      allow read, write: if true;
    }

    match /referral_conversions/{convId} {
      allow read, write: if true;
    }

    match /referral_payouts/{payoutId} {
      allow read, write: if true;
    }

    match /referral_config/{configId} {
      allow read, write: if true;
    }

    match /system_activity/{activityId} {
      allow read, write: if true;
    }

    // User profiles & business mapping
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    // Business Root Document
    match /businesses/{businessId} {
      allow read: if true; // Public profile details for receipts
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        request.resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.memberUids != null && request.auth.uid in request.resource.data.memberUids)
      );
      allow update, delete: if isSuperAdmin() || (isSignedIn() && isBusinessOwnerOrMember(resource.data));
      
      // Workstations Security Rule
      match /workstations/{deviceId} {
        allow read, create: if isAuthorizedForBusiness(businessId);
        // Only business owner can authorize/revoke workstation state; members can update heartbeats without altering isAuthorized
        allow update: if isAuthorizedForBusiness(businessId) && (
          isBusinessOwner(businessId) ||
          (resource.data.isAuthorized == request.resource.data.isAuthorized)
        );
        allow delete: if isBusinessOwner(businessId);
      }

      // Scannable digital receipts
      match /sales/{saleId} {
        allow read: if true;
        allow write: if isAuthorizedForBusiness(businessId);
      }

      // All subcollections (products, sales, customers, expenses, subusers, suppliers, purchaseOrders, saleOrders, estimates, creditNotes, deliveryNotes, budgets, roles, otherIncomes)
      match /{allSubcollections=**} {
        allow read, write: if isAuthorizedForBusiness(businessId);
      }
    }

    // Default deny all other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
