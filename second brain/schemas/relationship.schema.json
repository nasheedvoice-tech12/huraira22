{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VelcoraSecondBrainRelationship",
  "type": "object",
  "required": ["id", "tenantId", "sourceId", "targetId", "relationshipType", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "tenantId": { "type": "string" },
    "sourceId": { "type": "string" },
    "sourceType": { "type": "string" },
    "targetId": { "type": "string" },
    "targetType": { "type": "string" },
    "relationshipType": { "type": "string", "enum": ["mentions", "relates_to", "contradicts", "derived_from", "supports", "part_of", "owned_by", "depends_on"] },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string" },
    "metadata": { "type": "object" }
  }
}
